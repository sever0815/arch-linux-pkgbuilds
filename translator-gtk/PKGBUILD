# Maintainer: sever0815 <superjoika412@tred.su>

pkgname=translator-gtk
pkgver=0.1.0
pkgrel=2
pkgdesc="A small GTK4 translator written in Rust, powered by Google Translate"
arch=('x86_64')
url="https://github.com/wioletowa/Translator-gtk"
license=('MIT')
depends=('gtk4' 'tesseract' 'tesseract-data-eng' 'tesseract-data-rus' 'wl-clipboard' 'openssl')
makedepends=('cargo' 'base-devel' 'perl')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/heads/main.tar.gz"
        "translator-gtk.desktop"
        "Google_Translate_logo.png")
sha256sums=('SKIP'
            'SKIP'
            'SKIP')

prepare() {
    cd "Translator-gtk-main"

    # Rewrite Cargo.toml to use native-tls instead of rustls/ring
    cat > Cargo.toml << 'EOF'
[package]
name = "translator-gtk"
version = "0.1.0"
edition = "2021"

[dependencies]
gtk = { package = "gtk4", version = "0.9", features = ["v4_12"] }
ureq = { version = "2.10", features = ["json", "native-tls"], default-features = false }
serde = { version = "1", features = ["derive"] }
serde_json = "1"

[profile.release]
lto = false
codegen-units = 16
EOF

    export RUSTUP_TOOLCHAIN=stable
    rm -f Cargo.lock
    cargo generate-lockfile
}

build() {
    cd "Translator-gtk-main"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target

    cargo build --release
}

package() {
    cd "Translator-gtk-main"

    install -Dm755 "target/release/translator-gtk" "$pkgdir/usr/bin/translator-gtk"
    install -Dm644 "$srcdir/translator-gtk.desktop" "$pkgdir/usr/share/applications/translator-gtk.desktop"
    install -Dm644 "$srcdir/Google_Translate_logo.png" "$pkgdir/usr/share/pixmaps/Google_Translate_logo.png"
}
